{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/process/value_stream.schema.json",
  "title": "ValueStream",
  "description": "How value is realized; processes reference it.",
  "x-charter-spec-version": "1.0.0",
  "x-charter-schema-version": "1.0.0",
  "x-charter-requirements": [
    "CHR-PROC-001"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/documentBase"
    }
  ],
  "properties": {
    "charterSpecVersion": true,
    "namespace": true,
    "id": true,
    "name": true,
    "description": true,
    "lifecycleState": true,
    "validity": true,
    "extensions": true,
    "kind": {
      "const": "ValueStream"
    },
    "enterpriseId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "Enterprise"
      ]
    },
    "businessOutcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "kind",
    "name",
    "enterpriseId",
    "businessOutcome"
  ],
  "unevaluatedProperties": false
}
