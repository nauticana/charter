{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/process/gap.schema.json",
  "title": "Gap",
  "description": "Compares baseline and target elements and classifies the difference.",
  "x-charter-spec-version": "draft",
  "x-charter-schema-version": "0.1.0-draft",
  "x-charter-requirements": [
    "CHR-ARCH-004"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/documentBase"
    }
  ],
  "properties": {
    "charterSpecVersion": true,
    "namespace": true,
    "id": true,
    "name": true,
    "description": true,
    "lifecycleState": true,
    "validity": true,
    "extensions": true,
    "kind": {
      "const": "Gap"
    },
    "enterpriseId": {
      "$ref": "../common.schema.json#/$defs/idRef"
    },
    "baselineStateId": {
      "$ref": "../common.schema.json#/$defs/idRef"
    },
    "targetStateId": {
      "$ref": "../common.schema.json#/$defs/idRef"
    },
    "classification": {
      "type": "string",
      "enum": [
        "missing",
        "changed",
        "retired"
      ]
    },
    "comparedElements": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "../common.schema.json#/$defs/objectRef"
          }
        ]
      }
    }
  },
  "required": [
    "kind",
    "enterpriseId",
    "baselineStateId",
    "targetStateId",
    "classification",
    "description"
  ],
  "unevaluatedProperties": false
}
