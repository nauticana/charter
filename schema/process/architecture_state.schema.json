{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/process/architecture_state.schema.json",
  "title": "ArchitectureState",
  "description": "A time-bounded baseline or target description; target states name their decision authority.",
  "x-charter-requirements": [
    "CHR-ARCH-001",
    "CHR-ARCH-002",
    "CHR-ARCH-003",
    "CHR-ARCH-006",
    "CHR-INFO-009"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/documentBase"
    }
  ],
  "properties": {
    "charterSpecVersion": true,
    "namespace": true,
    "id": true,
    "name": true,
    "description": true,
    "lifecycleState": true,
    "validity": true,
    "extensions": true,
    "derivedFrom": true,
    "sourceEvidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/idRef"
      },
      "x-charter-ref-kinds": [
        "EvidenceRecord"
      ],
      "description": "Evidence the modeled facts rest on; required when they were derived rather than entered by their accountable owner (CHR-INFO-009)."
    },
    "kind": {
      "const": "ArchitectureState"
    },
    "enterpriseId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "Enterprise"
      ]
    },
    "stateType": {
      "type": "string",
      "enum": [
        "baseline",
        "target"
      ]
    },
    "decisionAuthority": {
      "allOf": [
        {
          "$ref": "../common.schema.json#/$defs/objectRef"
        }
      ]
    }
  },
  "required": [
    "kind",
    "name",
    "enterpriseId",
    "stateType",
    "description",
    "validity"
  ],
  "unevaluatedProperties": false,
  "if": {
    "properties": {
      "stateType": {
        "const": "target"
      }
    },
    "required": [
      "stateType"
    ]
  },
  "then": {
    "required": [
      "decisionAuthority"
    ]
  }
}
