{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/process/business_process.schema.json",
  "title": "BusinessProcess",
  "description": "Organizes work toward a declared business outcome; customer naming and hierarchy are preserved.",
  "x-charter-requirements": [
    "CHR-PROC-001",
    "CHR-PROC-003",
    "CHR-PROC-004",
    "CHR-INFO-009"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/documentBase"
    }
  ],
  "properties": {
    "charterSpecVersion": true,
    "namespace": true,
    "id": true,
    "name": true,
    "description": true,
    "lifecycleState": true,
    "validity": true,
    "extensions": true,
    "derivedFrom": true,
    "sourceEvidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/idRef"
      },
      "x-charter-ref-kinds": [
        "EvidenceRecord"
      ],
      "description": "Evidence the modeled facts rest on; required when they were derived rather than entered by their accountable owner (CHR-INFO-009)."
    },
    "kind": {
      "const": "BusinessProcess"
    },
    "enterpriseId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "Enterprise"
      ]
    },
    "businessOutcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "processDefinitionVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "The version a ProcessInstance must name to run this process; a changed definition is a new version."
    },
    "valueStreamId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "ValueStream"
      ]
    },
    "parentProcessId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "BusinessProcess"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "required": [
    "kind",
    "name",
    "enterpriseId",
    "businessOutcome",
    "processDefinitionVersion"
  ],
  "unevaluatedProperties": false
}
