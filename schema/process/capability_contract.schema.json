{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/process/capability_contract.schema.json",
  "title": "CapabilityContract",
  "description": "Stable business meaning of an operation, independent of protocol or vendor; execute contracts declare idempotency, and mutating contracts may declare verifiable postconditions.",
  "x-charter-requirements": [
    "CHR-CAP-001",
    "CHR-CAP-002",
    "CHR-CAP-003",
    "CHR-CAP-004",
    "CHR-CAP-005",
    "CHR-CAP-006",
    "CHR-CAP-008",
    "CHR-CAP-009",
    "CHR-CAP-010",
    "CHR-CAP-011",
    "CHR-CAP-012",
    "CHR-INFO-009"
  ],
  "type": "object",
  "$defs": {
    "predicate": {
      "description": "A machine-checkable condition over the invocation input and observed facts (CHR-CAP-012).",
      "type": "object",
      "properties": {
        "language": {
          "description": "Expression language; cel is the Common Expression Language.",
          "enum": [
            "cel"
          ]
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "language",
        "expression"
      ],
      "additionalProperties": false
    },
    "dataSchema": {
      "description": "Types the inputs or outputs by an InformationDefinition shape or an embedded JSON Schema (CHR-CAP-011).",
      "type": "object",
      "properties": {
        "informationId": {
          "$ref": "../common.schema.json#/$defs/idRef",
          "x-charter-ref-kinds": [
            "InformationDefinition"
          ]
        },
        "jsonSchema": {
          "$ref": "https://json-schema.org/draft/2020-12/schema",
          "type": "object"
        }
      },
      "oneOf": [
        {
          "required": [
            "informationId"
          ]
        },
        {
          "required": [
            "jsonSchema"
          ]
        }
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/documentBase"
    },
    {
      "if": {
        "required": [
          "postconditions"
        ]
      },
      "then": {
        "properties": {
          "idempotency": {
            "properties": {
              "mutating": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "charterSpecVersion": true,
    "namespace": true,
    "id": true,
    "name": true,
    "description": true,
    "lifecycleState": true,
    "validity": true,
    "extensions": true,
    "derivedFrom": true,
    "sourceEvidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/idRef"
      },
      "x-charter-ref-kinds": [
        "EvidenceRecord"
      ],
      "description": "Evidence the modeled facts rest on; required when they were derived rather than entered by their accountable owner (CHR-INFO-009)."
    },
    "kind": {
      "const": "CapabilityContract"
    },
    "enterpriseId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "Enterprise"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "operationClass": {
      "type": "string",
      "enum": [
        "read",
        "propose",
        "approve",
        "execute"
      ]
    },
    "contractVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "inputSchema": {
      "$ref": "#/$defs/dataSchema"
    },
    "outputSchema": {
      "$ref": "#/$defs/dataSchema"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "../common.schema.json#/$defs/identifier",
                "description": "Stable within the contract across contract versions."
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "predicate": {
                "$ref": "#/$defs/predicate"
              }
            },
            "required": [
              "id",
              "statement"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 1
    },
    "businessErrors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "description": "Defined independently of transport or protocol errors."
    },
    "requiredAuthority": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "constraints": {
      "type": "object",
      "properties": {
        "approvalRequired": {
          "type": "boolean"
        },
        "sodConstraintIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/idRef"
          },
          "uniqueItems": true,
          "x-charter-ref-kinds": [
            "SodConstraint"
          ]
        },
        "limits": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/limit"
          }
        }
      },
      "required": [
        "approvalRequired",
        "sodConstraintIds",
        "limits"
      ],
      "additionalProperties": false
    },
    "idempotency": {
      "type": "object",
      "properties": {
        "mutating": {
          "type": "boolean"
        },
        "retrySemantics": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "retryWhenEffectAbsent": {
          "type": "boolean",
          "description": "The mutation may be sent again once its effect is observed absent; absent or false, an absent effect never permits a retry under the same key (CHR-CAP-010)."
        }
      },
      "required": [
        "mutating",
        "retrySemantics"
      ],
      "additionalProperties": false
    },
    "evidenceRequirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 1
    },
    "postconditions": {
      "type": "array",
      "minItems": 1,
      "description": "Externally observable effects of the capability (CHR-CAP-009).",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "../common.schema.json#/$defs/identifier",
            "description": "Stable within the contract across contract versions."
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "verificationRequired": {
            "type": "boolean",
            "description": "The effect must be observed before an executed disposition may be recorded (CHR-CAP-010)."
          },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "description": "Declared outcomes the postcondition applies to; absent, it applies to every outcome."
          },
          "violationBusinessError": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Declared business error a violation is recorded as; absent, a violation is a failed effect."
          },
          "predicate": {
            "$ref": "#/$defs/predicate"
          }
        },
        "required": [
          "id",
          "statement",
          "verificationRequired"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "name",
    "purpose",
    "operationClass",
    "contractVersion",
    "inputs",
    "outputs",
    "preconditions",
    "outcomes",
    "businessErrors",
    "requiredAuthority",
    "constraints",
    "idempotency",
    "evidenceRequirements"
  ],
  "unevaluatedProperties": false
}
