{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/process/capability_contract.schema.json",
  "title": "CapabilityContract",
  "description": "Stable business meaning of an operation, independent of protocol or vendor; execute contracts declare idempotency.",
  "x-charter-spec-version": "1.0.0",
  "x-charter-schema-version": "1.0.0",
  "x-charter-requirements": [
    "CHR-CAP-001",
    "CHR-CAP-002",
    "CHR-CAP-003",
    "CHR-CAP-004",
    "CHR-CAP-005",
    "CHR-CAP-006",
    "CHR-CAP-008"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/documentBase"
    }
  ],
  "properties": {
    "charterSpecVersion": true,
    "namespace": true,
    "id": true,
    "name": true,
    "description": true,
    "lifecycleState": true,
    "validity": true,
    "extensions": true,
    "kind": {
      "const": "CapabilityContract"
    },
    "enterpriseId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "Enterprise"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "operationClass": {
      "type": "string",
      "enum": [
        "read",
        "propose",
        "approve",
        "execute"
      ]
    },
    "contractVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 1
    },
    "businessErrors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "description": "Defined independently of transport or protocol errors."
    },
    "requiredAuthority": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "constraints": {
      "type": "object",
      "properties": {
        "approvalRequired": {
          "type": "boolean"
        },
        "sodConstraintIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/idRef"
          },
          "uniqueItems": true,
          "x-charter-ref-kinds": [
            "SodConstraint"
          ]
        },
        "limits": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/limit"
          }
        }
      },
      "required": [
        "approvalRequired",
        "sodConstraintIds",
        "limits"
      ],
      "additionalProperties": false
    },
    "idempotency": {
      "type": "object",
      "properties": {
        "mutating": {
          "type": "boolean"
        },
        "retrySemantics": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "mutating",
        "retrySemantics"
      ],
      "additionalProperties": false
    },
    "evidenceRequirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 1
    }
  },
  "required": [
    "kind",
    "name",
    "purpose",
    "operationClass",
    "contractVersion",
    "inputs",
    "outputs",
    "preconditions",
    "outcomes",
    "businessErrors",
    "requiredAuthority",
    "constraints",
    "idempotency",
    "evidenceRequirements"
  ],
  "unevaluatedProperties": false
}
