{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/agent/agent_runtime.schema.json",
  "title": "AgentRuntime",
  "description": "An identifiable runtime instance acting as a stable agent identity under one agent definition.",
  "x-charter-spec-version": "1.0.0",
  "x-charter-schema-version": "2.0.0",
  "x-charter-requirements": [
    "CHR-ID-003",
    "CHR-AGENT-005",
    "CHR-AGENT-006"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/documentBase"
    }
  ],
  "properties": {
    "charterSpecVersion": true,
    "namespace": true,
    "id": true,
    "name": true,
    "description": true,
    "lifecycleState": {
      "$ref": "../common.schema.json#/$defs/identityLifecycleState"
    },
    "validity": true,
    "extensions": true,
    "kind": {
      "const": "AgentRuntime"
    },
    "enterpriseId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "Enterprise"
      ]
    },
    "agentIdentityId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "AgentIdentity"
      ]
    },
    "agentDefinitionId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "AgentDefinition"
      ]
    },
    "definitionVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "operator": {
      "$ref": "../common.schema.json#/$defs/objectRef"
    }
  },
  "required": [
    "kind",
    "enterpriseId",
    "agentIdentityId",
    "agentDefinitionId",
    "definitionVersion",
    "lifecycleState",
    "operator"
  ],
  "unevaluatedProperties": false
}
