{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/agent/sod_constraint.schema.json",
  "title": "SodConstraint",
  "description": "Separation-of-duties constraint identifying actions or responsibilities one actor may not combine.",
  "x-charter-spec-version": "1.0.0",
  "x-charter-schema-version": "1.0.0",
  "x-charter-requirements": [
    "CHR-AUTH-007"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/documentBase"
    }
  ],
  "properties": {
    "charterSpecVersion": true,
    "namespace": true,
    "id": true,
    "name": true,
    "description": true,
    "lifecycleState": true,
    "validity": true,
    "extensions": true,
    "kind": {
      "const": "SodConstraint"
    },
    "enterpriseId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "Enterprise"
      ]
    },
    "constrainedActions": {
      "type": "array",
      "items": {
        "$ref": "../common.schema.json#/$defs/idRef"
      },
      "uniqueItems": true,
      "minItems": 2,
      "description": "Capability or responsibility ids that must be performed by different actors.",
      "x-charter-ref-kinds": [
        "CapabilityContract",
        "Responsibility"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "kind",
    "enterpriseId",
    "constrainedActions"
  ],
  "unevaluatedProperties": false
}
