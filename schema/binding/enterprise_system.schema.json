{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/binding/enterprise_system.schema.json",
  "title": "EnterpriseSystem",
  "description": "An external system participating through profiles and bindings.",
  "x-charter-requirements": [
    "CHR-BIND-001"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/documentBase"
    }
  ],
  "properties": {
    "charterSpecVersion": true,
    "namespace": true,
    "id": true,
    "name": true,
    "description": true,
    "lifecycleState": true,
    "validity": true,
    "extensions": true,
    "derivedFrom": true,
    "kind": {
      "const": "EnterpriseSystem"
    },
    "enterpriseId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "Enterprise"
      ]
    }
  },
  "required": [
    "kind",
    "name"
  ],
  "unevaluatedProperties": false
}
