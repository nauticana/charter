{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/binding/data_binding.schema.json",
  "title": "DataBinding",
  "description": "Maps Charter information to external representations; lossy transformations declare their effect.",
  "x-charter-spec-version": "draft",
  "x-charter-schema-version": "0.1.0-draft",
  "x-charter-requirements": [
    "CHR-BIND-001",
    "CHR-BIND-002",
    "CHR-BIND-007",
    "CHR-INFO-006"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/documentBase"
    }
  ],
  "properties": {
    "charterSpecVersion": true,
    "namespace": true,
    "id": true,
    "name": true,
    "description": true,
    "lifecycleState": true,
    "validity": true,
    "extensions": true,
    "kind": {
      "const": "DataBinding"
    },
    "bindingVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "featureSupport": {
      "$ref": "../common.schema.json#/$defs/featureSupport"
    },
    "systemProfileId": {
      "$ref": "../common.schema.json#/$defs/idRef"
    },
    "informationDefinitionId": {
      "$ref": "../common.schema.json#/$defs/idRef"
    },
    "fieldMappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "charterPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "externalPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "transformation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "charterPath",
          "externalPath"
        ],
        "additionalProperties": false
      }
    },
    "lossyTransformations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "transformation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "effectOnValidation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "effectOnDecisions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "effectOnEvidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "transformation",
          "effectOnValidation",
          "effectOnDecisions",
          "effectOnEvidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "bindingVersion",
    "featureSupport",
    "systemProfileId",
    "informationDefinitionId",
    "fieldMappings"
  ],
  "unevaluatedProperties": false
}
