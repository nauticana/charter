{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/binding/system_profile.schema.json",
  "title": "SystemProfile",
  "description": "Identifies an external system, version, supported features, and operational constraints.",
  "x-charter-spec-version": "1.0.0",
  "x-charter-schema-version": "1.0.0",
  "x-charter-requirements": [
    "CHR-BIND-001",
    "CHR-BIND-002"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/documentBase"
    }
  ],
  "properties": {
    "charterSpecVersion": true,
    "namespace": true,
    "id": true,
    "name": true,
    "description": true,
    "lifecycleState": true,
    "validity": true,
    "extensions": true,
    "kind": {
      "const": "SystemProfile"
    },
    "enterpriseSystemId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "EnterpriseSystem"
      ]
    },
    "systemVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "supportedFeatures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "authenticationMethod": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "kind",
    "name",
    "enterpriseSystemId",
    "systemVersion",
    "supportedFeatures",
    "constraints"
  ],
  "unevaluatedProperties": false
}
