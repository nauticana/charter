{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/conformance/rule_definition.schema.json",
  "title": "ConformanceRuleDefinition",
  "description": "Format of a conformance rule definition under conformance/rules: identity, requirement citations, verification class, and fixtures.",
  "x-charter-spec-version": "1.0.0",
  "x-charter-schema-version": "1.0.0",
  "x-charter-requirements": ["CHR-CONF-006", "CHR-CONF-007", "CHR-CONF-011"],
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^CHR-RULE-[A-Z]+-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^CHR-[A-Z]+-[0-9]{3}$" }
    },
    "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "verification": { "enum": ["structural", "semantic", "runtime-behavioral"] },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 60 }
    },
    "check": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "fixtures": {
      "type": "object",
      "properties": {
        "valid": { "type": "string", "minLength": 1 },
        "invalid": { "type": "string", "minLength": 1 }
      },
      "required": ["valid", "invalid"],
      "additionalProperties": false
    }
  },
  "required": ["id", "title", "requirements", "profile", "verification", "applies_to", "check", "fixtures"],
  "additionalProperties": false
}
