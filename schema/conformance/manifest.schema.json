{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/conformance/manifest.schema.json",
  "title": "ConformanceManifest",
  "description": "Format of conformance/manifest.yaml: the inventory of profiles and rules and their activation status.",
  "x-charter-requirements": ["CHR-CONF-001", "CHR-CONF-006", "CHR-CONF-007"],
  "type": "object",
  "$defs": {
    "ruleId": { "type": "string", "pattern": "^CHR-RULE-[A-Z]+-[0-9]{3}$" },
    "status": { "enum": ["active", "planned", "retired"] }
  },
  "properties": {
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "status": { "$ref": "#/$defs/status" },
          "rules": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ruleId" } }
        },
        "required": ["id", "status", "rules"],
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/$defs/ruleId" },
          "status": { "$ref": "#/$defs/status" },
          "path": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "status", "path"],
        "additionalProperties": false
      }
    }
  },
  "required": ["profiles", "rules"],
  "additionalProperties": false
}
