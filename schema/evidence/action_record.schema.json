{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/evidence/action_record.schema.json",
  "title": "ActionRecord",
  "description": "Evidence for one governed action, attributable to identity and runtime context.",
  "x-charter-spec-version": "1.0.0",
  "x-charter-schema-version": "2.0.0",
  "x-charter-requirements": [
    "CHR-EVID-001",
    "CHR-EVID-002",
    "CHR-EVID-010",
    "CHR-AGENT-006",
    "CHR-INFO-007"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/documentBase"
    },
    {
      "if": {
        "properties": {
          "approvalEvaluations": {
            "contains": {
              "properties": {
                "result": {
                  "const": "approved"
                }
              },
              "required": [
                "result"
              ]
            }
          }
        },
        "required": [
          "approvalEvaluations"
        ]
      },
      "then": {
        "required": [
          "materialInputsDigest",
          "subjectRefs"
        ]
      }
    }
  ],
  "properties": {
    "charterSpecVersion": true,
    "namespace": true,
    "id": true,
    "name": true,
    "description": true,
    "lifecycleState": true,
    "validity": true,
    "extensions": true,
    "kind": {
      "const": "ActionRecord"
    },
    "enterpriseId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "Enterprise"
      ]
    },
    "actor": {
      "allOf": [
        {
          "$ref": "../common.schema.json#/$defs/objectRef"
        }
      ],
      "properties": {
        "kind": {
          "enum": [
            "HumanIdentity",
            "AgentIdentity"
          ]
        }
      }
    },
    "runtimeContext": {
      "type": "object",
      "properties": {
        "runtimeInstanceId": {
          "$ref": "../common.schema.json#/$defs/idRef",
          "x-charter-ref-kinds": [
            "AgentRuntime"
          ]
        },
        "executionContextId": {
          "$ref": "../common.schema.json#/$defs/identifier",
          "description": "Runtime-local execution identifier; unlike runtimeInstanceId, it need not identify a Charter document."
        }
      },
      "required": [
        "runtimeInstanceId",
        "executionContextId"
      ],
      "additionalProperties": false
    },
    "assignmentId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "Assignment"
      ]
    },
    "responsibilityId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "Responsibility"
      ]
    },
    "capabilityId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "CapabilityContract"
      ]
    },
    "materialInputsDigest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Digest of the material inputs used for this action; required when an approval is evaluated as approved."
    },
    "subjectRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../common.schema.json#/$defs/objectRef"
      },
      "description": "Business subjects of the action, used to bind evaluated approvals to the same context."
    },
    "operationClass": {
      "type": "string",
      "enum": [
        "read",
        "propose",
        "approve",
        "execute"
      ]
    },
    "actionTime": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "disposition": {
      "description": "How the attempt ended; executed and business-error report a declared outcome or business error, the others a stopped attempt (CHR-EVID-010).",
      "enum": [
        "executed",
        "business-error",
        "denied",
        "failed",
        "unknown"
      ]
    },
    "authorityEvaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "authorityGrantId": {
            "$ref": "../common.schema.json#/$defs/idRef",
            "x-charter-ref-kinds": [
              "AuthorityGrant"
            ]
          },
          "result": {
            "enum": [
              "allowed",
              "denied",
              "missing",
              "error"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "result",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "approvalEvaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "approvalId": {
            "$ref": "../common.schema.json#/$defs/idRef",
            "x-charter-ref-kinds": [
              "Approval"
            ]
          },
          "approvedAction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "result": {
            "enum": [
              "approved",
              "rejected",
              "not-required",
              "missing",
              "stale"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "result",
          "reason"
        ],
        "additionalProperties": false,
        "if": {
          "properties": {
            "result": {
              "const": "approved"
            }
          },
          "required": [
            "result"
          ]
        },
        "then": {
          "required": [
            "approvalId",
            "approvedAction"
          ]
        }
      }
    },
    "informationEvaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "informationId": {
            "$ref": "../common.schema.json#/$defs/idRef",
            "x-charter-ref-kinds": [
              "InformationDefinition"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "result": {
            "enum": [
              "allowed",
              "denied",
              "error"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "informationId",
          "purpose",
          "result",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "approvalIds": {
      "type": "array",
      "items": {
        "$ref": "../common.schema.json#/$defs/idRef"
      },
      "uniqueItems": true,
      "x-charter-ref-kinds": [
        "Approval"
      ]
    },
    "evidenceRecordIds": {
      "type": "array",
      "items": {
        "$ref": "../common.schema.json#/$defs/idRef"
      },
      "uniqueItems": true,
      "x-charter-ref-kinds": [
        "EvidenceRecord"
      ]
    }
  },
  "required": [
    "kind",
    "enterpriseId",
    "actor",
    "runtimeContext",
    "capabilityId",
    "operationClass",
    "actionTime",
    "outcome",
    "disposition"
  ],
  "unevaluatedProperties": false,
  "anyOf": [
    {
      "required": [
        "assignmentId"
      ]
    },
    {
      "required": [
        "responsibilityId"
      ]
    }
  ],
  "if": {
    "properties": {
      "operationClass": {
        "const": "execute"
      }
    },
    "required": [
      "operationClass"
    ]
  },
  "then": {
    "required": [
      "authorityEvaluations",
      "approvalEvaluations"
    ]
  }
}
