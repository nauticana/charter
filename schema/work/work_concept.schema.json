{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/work/work_concept.schema.json",
  "title": "WorkConcept",
  "description": "One term of a work classification: its identifier there, its labels, and its broader and related concepts in the same classification.",
  "x-charter-requirements": [
    "CHR-ENT-014"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/documentBase"
    }
  ],
  "properties": {
    "charterSpecVersion": true,
    "namespace": true,
    "id": true,
    "name": true,
    "description": true,
    "lifecycleState": true,
    "validity": true,
    "extensions": true,
    "derivedFrom": true,
    "kind": {
      "const": "WorkConcept"
    },
    "classificationId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "WorkClassification"
      ]
    },
    "externalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "preferredLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "description": "BCP 47 language tag.",
            "type": "string",
            "minLength": 2,
            "maxLength": 35
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "language",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "broaderConceptIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/idRef"
      },
      "x-charter-ref-kinds": [
        "WorkConcept"
      ]
    },
    "relatedConceptIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/idRef"
      },
      "x-charter-ref-kinds": [
        "WorkConcept"
      ]
    }
  },
  "required": [
    "kind",
    "classificationId",
    "externalId",
    "preferredLabel"
  ],
  "unevaluatedProperties": false
}
