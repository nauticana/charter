{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/information/information_definition.schema.json",
  "title": "InformationDefinition",
  "description": "The business meaning, ownership, classification, and policy context of governed information.",
  "x-charter-requirements": [
    "CHR-EVID-015",
    "CHR-INFO-001",
    "CHR-INFO-002",
    "CHR-INFO-010"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/documentBase"
    }
  ],
  "properties": {
    "charterSpecVersion": true,
    "namespace": true,
    "id": true,
    "name": true,
    "description": true,
    "lifecycleState": true,
    "validity": true,
    "extensions": true,
    "derivedFrom": true,
    "kind": {
      "const": "InformationDefinition"
    },
    "enterpriseId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "Enterprise"
      ]
    },
    "businessMeaning": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "ownerOrSteward": {
      "$ref": "../common.schema.json#/$defs/objectRef"
    },
    "classification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "governancePolicyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/idRef"
      },
      "x-charter-ref-kinds": [
        "InformationGovernancePolicy"
      ]
    },
    "shape": {
      "description": "Typed properties, identity, and relationships of the information (CHR-INFO-010).",
      "type": "object",
      "properties": {
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                "maxLength": 120
              },
              "type": {
                "description": "JSON Schema type of the property.",
                "enum": [
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "object",
                  "array"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "classification": {
                "description": "Classification of this property where it differs from the definition's.",
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "identity": {
          "description": "Required properties that together identify an instance.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
            "maxLength": 120
          }
        },
        "relationships": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                "maxLength": 120
              },
              "targetInformationId": {
                "$ref": "../common.schema.json#/$defs/idRef",
                "x-charter-ref-kinds": [
                  "InformationDefinition"
                ]
              },
              "cardinality": {
                "enum": [
                  "one",
                  "many"
                ]
              }
            },
            "required": [
              "name",
              "targetInformationId",
              "cardinality"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "properties",
        "identity"
      ],
      "additionalProperties": false
    },
    "factAuthority": {
      "description": "Sources of facts about this information, most authoritative first, and how long a fact stays current (CHR-EVID-014, CHR-EVID-015).",
      "type": "object",
      "properties": {
        "ranks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "systemProfileId": {
                "$ref": "../common.schema.json#/$defs/idRef",
                "x-charter-ref-kinds": [
                  "SystemProfile"
                ]
              },
              "category": {
                "enum": [
                  "observed-fact",
                  "agent-assertion",
                  "human-decision",
                  "external-response",
                  "derived-conclusion"
                ]
              }
            },
            "oneOf": [
              {
                "required": [
                  "systemProfileId"
                ]
              },
              {
                "required": [
                  "category"
                ]
              }
            ],
            "additionalProperties": false
          }
        },
        "maxAgeSeconds": {
          "description": "A fact whose validAt is more than this many seconds before the decision is stale.",
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "ranks"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "name",
    "enterpriseId",
    "businessMeaning",
    "ownerOrSteward",
    "classification",
    "governancePolicyIds"
  ],
  "unevaluatedProperties": false
}
