{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/enterprise/organization_unit.schema.json",
  "title": "OrganizationUnit",
  "description": "A structural node in the enterprise's organization-unit tree; `parentUnitId` defines the single rooted hierarchy.",
  "x-charter-requirements": [
    "CHR-ENT-001",
    "CHR-ENT-004",
    "CHR-ENT-005",
    "CHR-ENT-008",
    "CHR-INFO-009"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/documentBase"
    }
  ],
  "properties": {
    "charterSpecVersion": true,
    "namespace": true,
    "id": true,
    "name": true,
    "description": true,
    "lifecycleState": true,
    "validity": true,
    "extensions": true,
    "sourceEvidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/idRef"
      },
      "x-charter-ref-kinds": [
        "EvidenceRecord"
      ],
      "description": "Evidence the modeled facts rest on; required when they were derived rather than entered by their accountable owner (CHR-INFO-009)."
    },
    "kind": {
      "const": "OrganizationUnit"
    },
    "enterpriseId": {
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "Enterprise"
      ]
    },
    "parentUnitId": {
      "description": "Absent only for the root unit.",
      "$ref": "../common.schema.json#/$defs/idRef",
      "x-charter-ref-kinds": [
        "OrganizationUnit"
      ]
    }
  },
  "required": [
    "kind",
    "name",
    "enterpriseId"
  ],
  "unevaluatedProperties": false
}
