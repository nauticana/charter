{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/enterprise/enterprise.schema.json",
  "title": "Enterprise",
  "description": "The root governance boundary.",
  "x-charter-requirements": [
    "CHR-ENT-001",
    "CHR-ENT-004",
    "CHR-ENT-005",
    "CHR-CONF-001",
    "CHR-CONF-004",
    "CHR-INFO-009"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/documentBase"
    }
  ],
  "properties": {
    "charterSpecVersion": true,
    "namespace": true,
    "id": true,
    "name": true,
    "description": true,
    "lifecycleState": true,
    "validity": true,
    "extensions": true,
    "sourceEvidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/idRef"
      },
      "x-charter-ref-kinds": [
        "EvidenceRecord"
      ],
      "description": "Evidence the modeled facts rest on; required when they were derived rather than entered by their accountable owner (CHR-INFO-009)."
    },
    "kind": {
      "const": "Enterprise"
    }
  },
  "required": [
    "kind",
    "name"
  ],
  "unevaluatedProperties": false
}
