{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticana.github.io/charter/schema/enterprise/position_type.schema.json",
  "title": "PositionType",
  "description": "Classifies similar position instances across organization units without granting membership, responsibility, role, assignment, or authority.",
  "x-charter-spec-version": "draft",
  "x-charter-schema-version": "0.1.0-draft",
  "x-charter-requirements": [
    "CHR-ENT-001",
    "CHR-ENT-004",
    "CHR-ENT-010"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/documentBase"
    }
  ],
  "properties": {
    "charterSpecVersion": true,
    "namespace": true,
    "id": true,
    "name": true,
    "description": true,
    "lifecycleState": true,
    "validity": true,
    "extensions": true,
    "kind": {
      "const": "PositionType"
    },
    "enterpriseId": {
      "$ref": "../common.schema.json#/$defs/idRef"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "required": [
    "kind",
    "name",
    "enterpriseId",
    "purpose"
  ],
  "unevaluatedProperties": false
}
